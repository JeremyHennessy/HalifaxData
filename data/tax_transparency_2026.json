  "metadata": {
    "build": "020",
    "as_of": "2026-09-11",
    "status": "authoritative_parameter_contract",
    "purpose": "Support a transparent Nova Scotia salary deduction estimate and tax-dollar allocation view without implying that an individual's tax payment can be transaction-traced to a specific government expenditure.",
    "calculation_semantics": "Annualized CRA payroll-deduction estimate for a Nova Scotia employee using standard claim-code-1 basic personal amounts, no RRSP/RPP/union/commission/bonus/special deductions, and no spouse/dependant or other personal credits. This is not a filed-return calculation or a substitute for CRA PDOC.",
    "allocation_semantics": "Federal and Nova Scotia allocations are proportional illustrations using authoritative 2026-27 government expense plans. They show how an equal dollar of tax would be distributed if allocated in proportion to planned expenses; they do not trace the user's remittance to a specific program or transaction.",
    "municipal_semantics": "Halifax does not levy municipal personal income tax. HRM values are property-tax rates per $100 of taxable assessment and are calculated separately from salary deductions.",
    "currency": "CAD"
  },
